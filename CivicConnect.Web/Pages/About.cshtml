@page
@model AboutModel
@{
    ViewData["Title"] = "About CivicConnect";
}

<div class="container-fluid my-5 px-4">
    <!-- Header / Hero Banner -->
    <div class="text-center mb-5 p-5 rounded-4 text-white shadow-lg"
         style="background: linear-gradient(135deg, #1e1e2f 0%, #2a2a40 100%);">
        <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-2 rounded-pill mb-3 fs-6">
            Community First
        </span>
        <h1 class="display-4 fw-bold">About CivicConnect</h1>
        <p class="lead text-light opacity-75 mx-auto fs-4" style="max-width: 700px;">
            A simple, accessible portal designed to keep your community safe, clean, and well-maintained.
        </p>
    </div>

    <!-- How It Works Section (Elderly-Friendly Visual Steps) -->
    <div class="row g-4 mb-5">
        <div class="col-12 text-center mb-2">
            <h2 class="h1 fw-bold text-dark">How It Works in 3 Easy Steps</h2>
            <p class="text-muted fs-5">You report the issue, and local services handle the rest.</p>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-primary-subtle text-primary p-4 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-pencil-square fs-1"></i>
                    </div>
                    <h3 class="h4 fw-bold text-dark">1. Report Issue</h3>
                    <p class="text-secondary fs-5">Click "Report Issue", enter where the problem is located, and describe what needs fixing.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-warning-subtle text-warning p-4 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-clock-history fs-1"></i>
                    </div>
                    <h3 class="h4 fw-bold text-dark">2. Track Progress</h3>
                    <p class="text-secondary fs-5">View live updates on the dashboard as local teams review and assign workers to your ticket.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                <div class="card-body d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-success-subtle text-success p-4 mb-3 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-check-circle-fill fs-1"></i>
                    </div>
                    <h3 class="h4 fw-bold text-dark">3. Resolved!</h3>
                    <p class="text-secondary fs-5">Once repairs are completed, the ticket is marked as resolved for the entire community to see.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Help / Contact Box -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-center gap-4">
            <div>
                <h3 class="h3 fw-bold text-dark mb-2"><i class="bi bi-telephone-fill text-primary me-2"></i> Need Urgent Assistance?</h3>
                <p class="text-secondary mb-0 fs-5">For immediate life-threatening municipal emergencies, please call your local emergency services.</p>
            </div>
            <a asp-page="/Create" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fs-5 fw-bold shadow-sm text-nowrap">
                Report an Issue Now
            </a>
        </div>
    </div>
</div>