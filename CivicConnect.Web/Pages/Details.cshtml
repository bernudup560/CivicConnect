@page "{id:guid}"
@model CivicConnect.Web.Pages.DetailsModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Ticket Details - CivicConnect";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    bool isAdmin = User.IsInRole("Admin");
    bool isOwner = Model.Ticket != null && Model.Ticket.CreatedByUserId == currentUserId;
}

<div class="container-fluid my-5 px-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <a asp-page="/Index" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <span class="text-muted small">Ticket ID: #@Model.Ticket?.Id</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-info shadow-sm rounded-4 mb-4" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>@Model.Message
                </div>
            }

            @if (Model.Ticket != null)
            {
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-dark text-white p-4" style="background: linear-gradient(135deg, #1e1e2f 0%, #2a2a40 100%);">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-dark rounded-pill px-3 py-2">@Model.Ticket.CategoryName</span>
                            @{
                                var status = Model.Ticket.Status ?? string.Empty;
                                if (string.Equals(status, "Submitted", System.StringComparison.OrdinalIgnoreCase) || string.Equals(status, "Open", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6">Status: @status</span>
                                }
                                else if (string.Equals(status, "In Progress", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2 fs-6">Status: @status</span>
                                }
                                else if (string.Equals(status, "Resolved", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success text-white rounded-pill px-3 py-2 fs-6">Status: @status</span>
                                }
                                else if (string.Equals(status, "Closed", System.StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-secondary text-white rounded-pill px-3 py-2 fs-6">Status: @status</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-2 fs-6">Status: @status</span>
                                }
                            }
                        </div>
                        <h1 class="h2 fw-bold text-white mb-0">@Model.Ticket.Title</h1>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted d-block uppercase fw-bold mb-1">Location</small>
                                    <span class="fw-semibold text-dark"><i class="bi bi-geo-alt-fill text-primary me-1"></i> @Model.Ticket.Location</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted d-block uppercase fw-bold mb-1">Date Logged</small>
                                    <span class="fw-semibold text-dark"><i class="bi bi-calendar3 me-1"></i> @Model.Ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">Description</h5>
                        <p class="text-secondary leading-relaxed fs-5 mb-4">@Model.Ticket.Description</p>

                        <!-- Admin Status Management -->
                        @if (isAdmin)
                        {
                            <div class="p-4 bg-light rounded-4 border mb-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock-fill text-primary me-2"></i> Admin Controls: Update Status</h5>
                                <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-3 align-items-center">
                                    <input type="hidden" name="id" value="@Model.Ticket.Id" />
                                    <select name="newStatus" class="form-select form-select-lg rounded-3" style="max-width: 250px;">
                                        <option value="Submitted">Submitted</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Resolved">Resolved</option>
                                        <option value="Closed">Closed</option>
                                    </select>
                                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">Update Status</button>
                                </form>
                                <hr />
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-flag-fill text-warning me-2"></i> Admin Controls: Update Priority</h5>
                                <form method="post" asp-page-handler="ChangePriority" class="d-flex gap-3 align-items-center">
                                    <input type="hidden" name="id" value="@Model.Ticket.Id" />
                                    <select name="newPriority" class="form-select form-select-lg rounded-3" style="max-width: 220px;">
                                        @foreach (var opt in new[] { "Emergency", "High", "Medium", "Low" })
                                        {
                                            if (string.Equals(Model.Ticket.CalculatedPriority, opt, System.StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@opt" selected="selected">@opt</option>
                                            }
                                            else
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Change Priority</button>
                                </form>
                            </div>
                        }

                        <!-- Citizen Deletion (Admin cannot delete to preserve evidence) -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div>
                            @if (isOwner)
                                {
                                    <a asp-page="/Tickets/Edit" asp-route-id="@Model.Ticket.Id" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                                        <i class="bi bi-pencil-square me-1"></i> Edit My Report
                                    </a>

                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this ticket?');" style="display:inline-block">
                                        <input type="hidden" name="id" value="@Model.Ticket.Id" />
                                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                            <i class="bi bi-trash me-1"></i> Delete My Report
                                        </button>
                                    </form>
                                }
                            </div>
                            <div>
                                @if (isAdmin)
                                {
                                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Admin Audit Protection: Reports cannot be deleted by administrators.</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>