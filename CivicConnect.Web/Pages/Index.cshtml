@page
@model IndexModel
@{
    ViewData["Title"] = "All Tickets - CivicConnect";
}

<div class="container my-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">All Logged Tickets</h1>
            <p class="text-muted mb-0">Complete archive and active index of community requests.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-page="/Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Ticket
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="py-3 px-4">Title</th>
                        <th scope="col" class="py-3">Category</th>
                        <th scope="col" class="py-3">Priority</th>
                        <th scope="col" class="py-3">Location</th>
                        <th scope="col" class="py-3">Logged Date</th>
                        <th scope="col" class="py-3 px-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No tickets found in the system database.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-dark">@ticket.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        @ticket.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (string.Equals(ticket.CalculatedPriority, "Emergency", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(ticket.CalculatedPriority, "High", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill px-2 py-1">
                                            @ticket.CalculatedPriority.ToUpper()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info fw-semibold rounded-pill px-2 py-1">
                                            @ticket.CalculatedPriority
                                        </span>
                                    }
                                </td>
                                <td class="text-secondary small">
                                    <i class="bi bi-geo-alt me-1"></i>@ticket.Location
                                </td>
                                <td class="text-secondary small">@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>