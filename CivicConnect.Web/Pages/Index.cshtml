@page
@model CivicConnect.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Tickets Directory - CivicConnect";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="container my-5">
    <!-- Hero -->
    <section class="hero">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold section-title">@((isAdmin) ? "Community Requests Administration" : "Report & Track Community Issues")</h1>
                <p class="lead text-muted">Quickly log issues, follow progress and collaborate with municipal teams to resolve problems in your area.</p>
                <div class="mt-3 d-flex gap-2">
                    <a asp-page="/Create" class="btn btn-primary btn-lg">Report an Issue</a>
                    <a asp-page="/Tickets/Index" class="btn btn-outline-primary btn-lg">Browse Tickets</a>
                </div>
            </div>
            <div class="col-md-5 text-end">
                @if (isAdmin && Model.HasAdminHeroImage)
                {
                    <!-- Admin hero image -->
                    <img src="~/images/marlis-trio-akbar-eMB60hNHFL8-unsplash.jpg" alt="Community hands (admin)" class="illustration floaty img-fluid rounded-3 shadow-sm" onerror="this.onerror=null;this.src='~/lib/marlis-trio-akbar-eMB60hNHFL8-unsplash.jpg'" />
                }
                else if (!isAdmin && Model.HasUserHeroImage)
                {
                    <!-- User-facing hero image -->
                    <img src="~/images/pexels-ferdous-9225479.jpg" alt="Community scene" class="illustration floaty img-fluid rounded-3 shadow-sm" onerror="this.onerror=null;this.src='~/lib/pexels-ferdous-9225479.jpg'" />
                }
                else
                {
                    <svg class="illustration floaty" viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <defs>
                            <linearGradient id="g1" x1="0" x2="1">
                                <stop offset="0%" stop-color="#0B5AA6" stop-opacity="0.9"/>
                                <stop offset="100%" stop-color="#084a86" stop-opacity="0.9"/>
                            </linearGradient>
                        </defs>
                        <rect x="50" y="40" rx="14" ry="14" width="420" height="220" fill="url(#g1)" />
                    </svg>
                }
            </div>
        </div>
    </section>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">@(isAdmin ? "All Community Requests (Admin Access)" : "My Submitted Reports")</h2>
            <p class="text-muted fs-6 mb-0">Filter, search, and track resolution updates.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-page="/Create" class="btn btn-primary btn-lg rounded-pill px-4 py-2 fs-5 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Report New Issue
            </a>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <form method="get" class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" asp-for="SearchKeyword" class="form-control form-control-lg rounded-3" placeholder="Search title or location..." />
            </div>
            <div class="col-md-3">
                <select asp-for="SelectedCategory" class="form-select form-select-lg rounded-3">
                    <option value="">All Categories</option>
                    <option value="Roads & Potholes">Roads & Potholes</option>
                    <option value="Water & Sanitation">Water & Sanitation</option>
                    <option value="Electricity & Lighting">Electricity & Lighting</option>
                </select>
            </div>
            <div class="col-md-3">
                <select asp-for="SelectedStatus" class="form-select form-select-lg rounded-3">
                    <option value="">All Statuses</option>
                    <option value="Submitted">Submitted</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark btn-lg rounded-pill w-100 fw-bold">Filter</button>
            </div>
        </div>
    </form>

    <!-- Tickets Table View -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-5">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4">Ticket #</th>
                        <th class="py-3 px-4">Title</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Location</th>
                        <th class="py-3 px-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td class="px-4 text-muted fw-semibold">@ticket.TicketNumber</td>
                            <td class="px-4 fw-bold">@ticket.Title</td>
                            <td><span class="badge bg-light text-dark border rounded-pill px-3 py-2 fs-6">@ticket.CategoryName</span></td>
                            <td><span class="badge bg-info-subtle text-info fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span></td>
                            <td class="text-secondary fs-6"><i class="bi bi-geo-alt-fill text-primary me-1"></i>@ticket.Location</td>
                            <td class="px-4 text-end">
                                <a asp-page="/Details" asp-route-id="@ticket.Id" class="btn btn-outline-primary rounded-pill px-4 py-2 fs-6 fw-bold">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @{ var createdNumber = TempData["CreatedTicketNumber"] as string; }
    @if (!string.IsNullOrWhiteSpace(createdNumber))
    {
        <!-- Ticket Created Modal -->
        <div class="modal fade" id="createdTicketModal" tabindex="-1" aria-labelledby="createdTicketModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="createdTicketModalLabel">Thank you</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p class="mb-2">Thank you for reporting to us.</p>
                        <p class="display-4 fw-bold text-primary">@createdNumber</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('createdTicketModal');
                if (modalEl && typeof bootstrap !== 'undefined') {
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            });
        </script>
    }
                    <p class="mb-1">This is your ticket number:</p>
                    <p class="display-6 fw-bold text-primary">@createdNumber</p>
                    <p class="small text-muted mt-2">Please save this number to track progress or share with support.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>