@page
@model CivicConnect.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Account - CivicConnect";
}

<div class="container-fluid my-5 px-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center" 
                     style="background: linear-gradient(135deg, #1e1e2f 0%, #2a2a40 100%);">
                    <h2 class="h3 fw-bold mb-0">Create Citizen Account</h2>
                    <p class="text-light opacity-75 small mb-0">Join CivicConnect to log and manage local requests</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="John Doe" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" placeholder="name@example.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold shadow-sm">
                            Register Account <i class="bi bi-person-plus ms-1"></i>
                        </button>
                    </form>
                    <div class="text-center pt-3 border-top mt-4">
                        <span class="text-muted">Already registered? </span>
                        <a asp-page="/Account/Login" class="fw-bold text-primary text-decoration-none">Sign In Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>