@page
@model CivicConnect.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In - CivicConnect";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center" 
                     style="background: linear-gradient(135deg, #1e1e2f 0%, #2a2a40 100%);">
                    <i class="bi bi-person-circle display-3 text-primary mb-2"></i>
                    <h2 class="h3 fw-bold mb-0">Welcome Back</h2>
                    <p class="text-light opacity-75 small mb-0">Sign in to your CivicConnect account</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3 fs-6 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                        </div>
                    }

                    <!-- Quick Demo Credentials Box -->
                    <div class="alert alert-info rounded-3 mb-4 fs-6">
                        <strong class="d-block mb-1"><i class="bi bi-key-fill me-1"></i> Demo Credentials:</strong>
                        <div class="small"><strong>Admin:</strong> <code>admin@civicconnect.gov.za</code> / <code>Admin123!</code></div>
                        <div class="small"><strong>Citizen:</strong> <code>user@civicconnect.co.za</code> / <code>User123!</code></div>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="name@example.com" required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold text-dark">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" placeholder="••••••••" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold shadow-sm mb-3">
                            Sign In <i class="bi bi-box-arrow-in-right ms-1"></i>
                        </button>
                    </form>

                    <div class="text-center pt-3 border-top">
                        <span class="text-muted">Don't have an account? </span>
                        <a asp-page="/Account/Register" class="fw-bold text-primary text-decoration-none">Register Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>