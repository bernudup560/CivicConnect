<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CivicConnect</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Font: Inter (optional) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* small tweak for primary icon alignment */
        .navbar-brand .bi { font-size: 1.3rem; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- Header / Navigation Bar -->
    <header>
        <nav class="navbar fixed-top navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm w-100">
            <div class="container-fluid d-flex justify-content-between align-items-center px-4">
                <a class="navbar-brand fw-bold fs-3 text-white d-flex align-items-center me-3" asp-page="/Index">
                    <i class="bi bi-building-fill-gear text-primary me-2"></i>
                    <span class="d-none d-md-inline">CivicConnect</span>
                </a>

                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto ms-lg-4 fs-6 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link text-white px-3" asp-page="/Index"><i class="bi bi-house-door me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white px-3" asp-page="/Tickets/Index"><i class="bi bi-list-task me-1"></i> Tickets</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white px-3" asp-page="/Tickets/My"><i class="bi bi-person-lines-fill me-1"></i> My Tickets</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-white px-3" asp-page="/About"><i class="bi bi-info-circle me-1"></i> About</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-light fs-6 d-flex align-items-center">
                                <i class="bi bi-person-circle text-primary me-1"></i>
                                <span class="me-2">@User.Identity.Name</span>
                                <span class="badge bg-primary rounded-pill ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </span>
                            <a asp-page="/Account/Logout" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 fs-6">Sign Out</a>
                        }
                        else
                        {
                            <a asp-page="/Account/Login" class="btn btn-outline-light rounded-pill px-3 py-2 fs-6">Sign In</a>
                            <a asp-page="/Account/Register" class="btn btn-primary rounded-pill px-4 py-2 fs-6 fw-bold">Register</a>
                        }

                        <a asp-page="/Create" class="btn btn-primary rounded-pill px-4 py-2 fs-6 fw-bold shadow-sm">
                            <i class="bi bi-plus-circle-fill me-1"></i> Report Issue
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Accessible Footer -->
        <footer class="bg-dark text-white py-4 mt-auto border-top border-secondary border-opacity-25">
        <div class="container-fluid text-center px-4">
            <p class="mb-1 fs-5">&copy; @DateTime.Now.Year CivicConnect Community Portal. Built for accessible civic engagement.</p>
            <div class="d-flex justify-content-center gap-4 mt-2 fs-6">
                <a asp-page="/Index" class="text-white-50 text-decoration-none">Dashboard</a>
                <a asp-page="/Tickets/Index" class="text-white-50 text-decoration-none">Tickets</a>
                <a asp-page="/About" class="text-white-50 text-decoration-none">About</a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>