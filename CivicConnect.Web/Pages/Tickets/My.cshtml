@page
@model CivicConnect.Web.Pages.Tickets.MyModel
@{
    ViewData["Title"] = "My Tickets - CivicConnect";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">My Submitted Reports</h1>
        <a asp-page="/Create" class="btn btn-primary">Report New Issue</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-5">
                <thead class="table-dark">
                    <tr>
                        <th class="py-3 px-4">Ticket #</th>
                        <th class="py-3 px-4">Title</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Location</th>
                        <th class="py-3">Date</th>
                        <th class="py-3 px-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                You have not submitted any tickets yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td class="px-4 text-muted fw-semibold">@ticket.TicketNumber</td>
                                <td class="px-4 fw-bold">@ticket.Title</td>
                                <td><span class="badge bg-info-subtle text-info fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span></td>
                                <td class="text-secondary fs-6">@ticket.Location</td>
                                <td class="text-secondary fs-6">@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Details" asp-route-id="@ticket.Id" class="btn btn-outline-primary rounded-pill px-4 py-2 fs-6 fw-bold">View</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
