@page "{id:guid}"
@model CivicConnect.Web.Pages.Tickets.EditModel
@{
    ViewData["Title"] = "Edit Report - CivicConnect";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a asp-page="/Details" asp-route-id="@Model.Ticket?.Id" class="btn btn-link mb-3">← Back to details</a>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h2 class="h4 mb-3">Edit Your Report</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <input type="hidden" asp-for="Ticket.Id" />

                    <div class="mb-3">
                        <label asp-for="Ticket.Title" class="form-label">Title</label>
                        <input asp-for="Ticket.Title" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ticket.Description" class="form-label">Description</label>
                        <textarea asp-for="Ticket.Description" class="form-control" rows="6"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ticket.CategoryName" class="form-label">Category</label>
                        <input asp-for="Ticket.CategoryName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ticket.Location" class="form-label">Location</label>
                        <input asp-for="Ticket.Location" class="form-control" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="/Details" asp-route-id="@Model.Ticket?.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>