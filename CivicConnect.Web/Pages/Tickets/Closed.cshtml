@page
@model CivicConnect.Web.Pages.Tickets.ClosedModel
@{
    ViewData["Title"] = "Closed & Completed Tickets - CivicConnect";
}

<div class="container-fluid my-5 px-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-1">Closed & Completed Reports</h1>
            <p class="text-muted fs-5 mb-0">View reports that have been resolved or closed.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-page="/Tickets/Index" class="btn btn-outline-primary btn-lg rounded-pill px-4 py-2 fs-5 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to All Tickets
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm rounded-4 mb-4 fs-5" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 fs-5">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="py-3 px-4">Title</th>
                        <th scope="col" class="py-3">Category</th>
                        <th scope="col" class="py-3">Status</th>
                        <th scope="col" class="py-3">Priority</th>
                        <th scope="col" class="py-3">Location</th>
                        <th scope="col" class="py-3">Date Logged</th>
                        <th scope="col" class="py-3 px-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Tickets.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                No closed or completed tickets found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-dark">@ticket.Title</td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-normal fs-6">
                                        @ticket.CategoryName
                                    </span>
                                </td>
                                <td>
                                    @if (string.Equals(ticket.Status, "Submitted", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(ticket.Status, "Open", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span>
                                    }
                                    else if (string.Equals(ticket.Status, "In Progress", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span>
                                    }
                                    else if (string.Equals(ticket.Status, "Resolved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success text-white fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span>
                                    }
                                    else if (string.Equals(ticket.Status, "Closed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-secondary text-white fw-semibold rounded-pill px-3 py-2 fs-6">@ticket.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark fw-normal rounded-pill px-3 py-2 fs-6">@ticket.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (string.Equals(ticket.CalculatedPriority, "Emergency", StringComparison.OrdinalIgnoreCase) ||
                                         string.Equals(ticket.CalculatedPriority, "High", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill px-3 py-2 fs-6">
                                            <i class="bi bi-exclamation-circle me-1"></i>@ticket.CalculatedPriority.ToUpper()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info fw-semibold rounded-pill px-3 py-2 fs-6">
                                            @ticket.CalculatedPriority
                                        </span>
                                    }
                                </td>
                                <td class="text-secondary fs-6">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>@ticket.Location
                                </td>
                                <td class="text-secondary fs-6">@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Details" asp-route-id="@ticket.Id" class="btn btn-outline-primary rounded-pill px-4 py-2 fs-6 fw-bold">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>