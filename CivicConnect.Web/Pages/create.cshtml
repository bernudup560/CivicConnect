@page
@model CreateModel
@{
    ViewData["Title"] = "Report Issue - CivicConnect";
}

<div class="container-fluid my-5 px-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0"
                     style="background: linear-gradient(135deg, #1e1e2f 0%, #2a2a40 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="badge bg-primary-subtle text-primary fw-bold text-uppercase px-3 py-1 rounded-pill mb-2">
                                Service Request
                            </span>
                            <h2 class="h3 fw-bold mb-0">Report a Community Issue</h2>
                        </div>
                        <i class="bi bi-megaphone fs-1 text-primary opacity-75"></i>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }

                    <form method="post" class="needs-validation">
                        <!-- Issue Title -->
                        <div class="mb-4">
                            <label asp-for="Ticket.Title" class="form-label fw-semibold text-dark">Issue Title</label>
                            <input asp-for="Ticket.Title"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g., Pothole on Main Street"
                                   pattern=".*[a-zA-Z]+.*"
                                   title="Issue Title must contain letters, not just numbers."
                                   required />
                            <span asp-validation-for="Ticket.Title" class="text-danger small"></span>
                        </div>

                        <!-- Category & Location Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Ticket.CategoryId" class="form-label fw-semibold text-dark">Category</label>
                                <select asp-for="Ticket.CategoryId" class="form-select form-select-lg rounded-3" required>
                                   <option value="">Select Category...</option>
                                    <option value="1">Water and sanitation</option>
                                    <option value="2">Roads and potholes</option>
                                    <option value="3">Street lighting</option>
                                    <option value="4">Waste collection</option>
                                    <option value="5">Parks and recreation</option>
                                </select>
                                <span asp-validation-for="Ticket.CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Ticket.Location" class="form-label fw-semibold text-dark">Location / Address</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Ticket.Location"
                                           class="form-control rounded-end-3"
                                           placeholder="Street, suburb, or landmark"
                                           pattern=".*[a-zA-Z]+.*"
                                           title="Location must include a street or suburb name, not just numbers."
                                           required />
                                </div>
                                <span asp-validation-for="Ticket.Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Ticket.Description" class="form-label fw-semibold text-dark">Detailed Description</label>
                            <textarea asp-for="Ticket.Description" class="form-control rounded-3" rows="5" placeholder="Provide extra context or visual details..." required></textarea>
                            <span asp-validation-for="Ticket.Description" class="text-danger small"></span>
                        </div>

                        <!-- Emergency flag -->
                        <div class="form-check mb-4 p-3 rounded-3 border border-danger-subtle bg-danger-subtle">
                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Ticket.IsEmergency" />
                            <label class="form-check-label fw-semibold text-danger" asp-for="Ticket.IsEmergency">
                                Mark as Emergency (Immediate Safety or Infrastructure Risk)
                            </label>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-page="/Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                Submit Ticket <i class="bi bi-send ms-1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>